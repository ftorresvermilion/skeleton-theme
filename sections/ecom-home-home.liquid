document.addEventListener("DOMContentLoaded", function () {
 // ---------- DESKTOP ----------
 const cards = [
 document.querySelector(".card1-herohome"),
 document.querySelector(".card2-herohome"),
 document.querySelector(".card3-herohome"),
 document.querySelector(".card4-herohome")
 ];
 const videos = [
 document.querySelector(".video-slide-1"),
 document.querySelector(".video-slide-2"),
 document.querySelector(".video-slide-3"),
 document.querySelector(".video-slide-4")
 ];
 const videosMobile = [
 null,
 document.querySelector(".video-slide-2-mobile"),
 document.querySelector(".video-slide-3-mobile"),
 document.querySelector(".video-slide-4-mobile")
 ];
 const dots = [
 document.querySelector(".dot1-herohome"),
 document.querySelector(".dot2-herohome"),
 document.querySelector(".dot3-herohome"),
 document.querySelector(".dot4-herohome")
 ];
 let currentIndex = 0;
 function showCard(index) {
 currentIndex = index;
 // Cards
 cards.forEach((card, i) => {
 if (card) card.style.display = i === index ? "flex" : "none";
 });
 // Videos (desktop)
 videos.forEach((video, i) => {
 if (video) video.classList.toggle("active-slide", i === index);
 });
 // Videos (mobile)
 videosMobile.forEach((video, i) => {
 if (video) video.classList.toggle("active-slide", i === index);
 });
 // Active dot (desktop)
 dots.forEach((dot, i) => {
 if (dot) dot.classList.toggle("active-dot", i === index);
 });
 }
 function nextCard() {
 const next = (currentIndex + 1) % cards.length;
 showCard(next);
 }
 // Initial state
 showCard(0);
 // Click events (desktop dots)
 dots.forEach((dot, index) => {
 if (dot) {
 dot.addEventListener("click", function (e) {
 e.preventDefault();
 showCard(index);
 });
 }
 });
 // Next button (arrow-right)
 document.querySelectorAll(".arrow-right").forEach((arrow) => {
 arrow.addEventListener("click", function (e) {
 e.preventDefault();
 nextCard();
 });
 });
});
</script>
